From: webj8-overlay maintainers
Subject: [PATCH] wine: keep assembly entry points with Clang full LTO

Rebased for Wine 11.12 after the winello-v11.12-1 patch stack.
Based on the AUR wine-osu-spectator-wow64 lto-fixup.patch:
https://aur.archlinux.org/cgit/aur.git/tree/lto-fixup.patch?h=wine-osu-spectator-wow64&id=be5bc227695211db81aeee4b2bb738e36d19cbb4

Keep assembly-referenced symbols during full LTO and compile/link Wine's
preloader without LTO.  Teach makedep to append object-local CFLAGS so
preloader_CFLAGS can override global -flto=full.

diff --git a/dlls/ntdll/unix/signal_arm.c b/dlls/ntdll/unix/signal_arm.c
index ee3a21c..30bb7a6 100644
--- a/dlls/ntdll/unix/signal_arm.c
+++ b/dlls/ntdll/unix/signal_arm.c
@@ -1111,7 +1111,7 @@ void signal_init_process( TEB *teb )
 /***********************************************************************
  *           init_syscall_frame
  */
-__attribute__((used)) void init_syscall_frame( LPTHREAD_START_ROUTINE entry, void *arg, TEB *teb )
+__attribute__((retain,used)) void init_syscall_frame( LPTHREAD_START_ROUTINE entry, void *arg, TEB *teb )
 {
     struct thread_data *data = get_thread_data();
     struct syscall_frame *frame = get_syscall_frame( data );
diff --git a/dlls/ntdll/unix/signal_arm64.c b/dlls/ntdll/unix/signal_arm64.c
index 6786cb6..4430b59 100644
--- a/dlls/ntdll/unix/signal_arm64.c
+++ b/dlls/ntdll/unix/signal_arm64.c
@@ -1521,7 +1521,7 @@ void syscall_dispatcher_return_slowpath(void)
 /***********************************************************************
  *           init_syscall_frame
  */
-__attribute__((used)) void init_syscall_frame( LPTHREAD_START_ROUTINE entry, void *arg, TEB *teb )
+__attribute__((retain,used)) void init_syscall_frame( LPTHREAD_START_ROUTINE entry, void *arg, TEB *teb )
 {
     struct thread_data *data = get_thread_data();
     struct syscall_frame *frame = get_syscall_frame( data );
