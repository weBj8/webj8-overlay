diff --git a/loader/Makefile.in b/loader/Makefile.in
index a9ca82f..790ad60 100644
--- a/loader/Makefile.in
+++ b/loader/Makefile.in
@@ -11,6 +11,7 @@ INSTALL_LIB = $(WINELOADER_PROGRAMS)
 UNIX_CFLAGS = -fPIE
 
 preloader_EXTRADEFS = -fno-builtin
+preloader_CFLAGS = -fno-lto
 
 wine_OBJS = main.o
 wine_DEPS = $(WINELOADER_DEPENDS)
@@ -18,4 +19,4 @@ wine_LDFLAGS = $(WINELOADER_LDFLAGS) $(LDEXECFLAGS) $(PTHREAD_LIBS)
 
 wine_preloader_OBJS = preloader.o preloader_mac.o
 wine_preloader_DEPS = $(WINELOADER_DEPENDS)
-wine_preloader_LDFLAGS = $(WINEPRELOADER_LDFLAGS)
+wine_preloader_LDFLAGS = $(WINEPRELOADER_LDFLAGS) -fno-lto -fuse-ld=lld -Wl,--no-relax
diff --git a/loader/preloader.c b/loader/preloader.c
index deae42d..9c629a0 100644
--- a/loader/preloader.c
+++ b/loader/preloader.c
@@ -89,7 +89,9 @@
 #include "wine/asm.h"
 #include "main.h"
 
-#pragma GCC visibility push(hidden)
+#if !defined(__LLD_LTO__)
+# pragma GCC visibility push(hidden)
+#endif
 
 /* ELF definitions */
 #define ELF_PREFERRED_ADDRESS(loader, maplength, mapstartpref) (mapstartpref)
@@ -179,7 +181,7 @@ void __bb_init_func(void) { return; }
 
 /* data for setting up the glibc-style thread-local storage in %gs */
 
-static int thread_data[256] __attribute__((used));
+static int thread_data[256] __attribute__((retain,used));
 
 struct
 {
@@ -194,7 +196,7 @@ struct
     unsigned int  seg_not_present : 1;
     unsigned int  usable : 1;
     unsigned int  garbage : 25;
-} thread_ldt __attribute__((used)) = { -1, (unsigned long)thread_data, 0xfffff, 1, 0, 0, 1, 0, 1, 0 };
+} thread_ldt __attribute__((retain,used)) = { -1, (unsigned long)thread_data, 0xfffff, 1, 0, 0, 1, 0, 1, 0 };
 
 
 /*
@@ -335,7 +337,7 @@ static inline int wld_prctl( int code, long arg )
 
 #elif defined(__x86_64__)
 
-void *thread_data[256] __attribute__((used));
+void *thread_data[256] __attribute__((retain,used));
 
 /*
  * The _start function is the entry and exit point of this program
@@ -424,7 +426,7 @@ SYSCALL_NOERR( wld_getegid, 108 /* SYS_getegid */ );
 
 #elif defined(__aarch64__)
 
-void *thread_data[256] __attribute__((used));
+void *thread_data[256] __attribute__((retain,used));
 
 /*
  * The _start function is the entry and exit point of this program
@@ -531,7 +533,7 @@ SYSCALL_NOERR( wld_getegid, 177 /* SYS_getegid */ );
 
 #elif defined(__arm__)
 
-void *thread_data[256];
+void *thread_data[256] __attribute__((retain,used));
 
 /*
  * The _start function is the entry and exit point of this program
@@ -1397,7 +1399,7 @@ static void set_process_name( int argc, char *argv[] )
  *  Load the binary and then its ELF interpreter.
  *  Note, we assume that the binary is a dynamically linked ELF shared object.
  */
-__attribute__((used)) void* wld_start( void **stack )
+__attribute__((retain,used)) void* wld_start( void **stack )
 {
     long i, *pargc;
     char **argv, **p;
@@ -1523,6 +1525,8 @@ __attribute__((used)) void* wld_start( void **stack )
     return (void *)ld_so_map.l_entry;
 }
 
-#pragma GCC visibility pop
+#if !defined(__LLD_LTO__)
+# pragma GCC visibility pop
+#endif
 
 #endif /* __linux__ */
diff --git a/tools/makedep.c b/tools/makedep.c
index b1b5131..f428b3f 100644
--- a/tools/makedep.c
+++ b/tools/makedep.c
@@ -3778,6 +3778,7 @@ static void output_source_one_arch( struct makefile *make, struct incl_file *sou
     output_filenames( defines );
     output_filenames( cflags );
     output_filename( var_cflags );
+    output_filenames( get_expanded_file_local_var( make, obj, "CFLAGS" ));
     output( "\n" );
 
     if (make->testdll && strendswith( source->name, ".c" ) &&
@@ -3841,6 +3842,7 @@ static void output_source_one_arch( struct makefile *make, struct incl_file *sou
         cmd->cmd = get_expanded_arch_var( make, "CC", arch );
         if (cflags) strarray_add( &cmd->args, cflags );
     }
+    strarray_addall( &cmd->args, get_expanded_file_local_var( make, obj, "CFLAGS" ));
     list_add_tail( &compile_commands, &cmd->entry );
 }
 
